# ─── Sanity ────────────────────────────────────────────────────────────────────
# Get these from https://www.sanity.io/manage → your project → API
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01
# Read token (viewer role) — needed for server-side GROQ queries on draft content
SANITY_API_READ_TOKEN=
# Secret used to verify webhook payloads from Sanity → on-demand ISR revalidation
SANITY_WEBHOOK_SECRET=

# ─── Supabase ──────────────────────────────────────────────────────────────────
# Get these from https://supabase.com/dashboard → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
# Service role key — SERVER ONLY. Never expose to browser.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Resend (used in Sprint 2+) ────────────────────────────────────────────────
# Create API key at https://resend.com/api-keys
RESEND_API_KEY=
# "From" address must be from a verified domain in Resend
RESEND_FROM_EMAIL=
# Author's notification email (where brief/whisper alerts go)
AUTHOR_NOTIFICATION_EMAIL=

# ─── Cloudflare Turnstile (used in Sprint 2+) ──────────────────────────────────
# Get from https://dash.cloudflare.com → Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ─── Site ──────────────────────────────────────────────────────────────────────
# Full URL, no trailing slash
NEXT_PUBLIC_SITE_URL=http://localhost:3000
